# ProxyAPI (OpenAI-compatible)
# Ключ: https://proxyapi.ru/ — подставьте свой, без кавычек.
# Пустой LLM_API_KEY = offline extractive-режим (без вызова модели).
LLM_API_KEY=
LLM_BASE_URL=https://api.proxyapi.ru/openai/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Альтернатива: универсальный OpenAI-совместимый шлюз ProxyAPI
# (тогда имя модели с префиксом провайдера, например openai/gpt-4o-mini):
# LLM_BASE_URL=https://openai.api.proxyapi.ru/v1
# LLM_MODEL=openai/gpt-4o-mini

# SQLite (KB_ prefix — чтобы не пересекаться с глобальным DATABASE_URL)
KB_DATABASE_URL=sqlite:///./data/knowledge.db

# Search
SEARCH_TOP_K=5
